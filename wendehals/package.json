{
  "name": "wendehals",
  "productName": "Wendehals",
  "version": "0.2.0",
  "description": "Metroidvania-Shoot'em-Up: Welt erkunden, Richtung drehen, abgedrehte Gegner.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node --test \"tests/*.tests.mjs\"",
    "build": "node tools/build.mjs",
    "e2e": "npm run build && node e2e/smoke.mjs",
    "check": "npm test && npm run e2e",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux --x64 --publish never",
    "e2e:desktop": "node e2e/electron.mjs",
    "icon": "node tools/make-icon.mjs",
    "e2e:perf": "npm run build && node e2e/perf.mjs",
    "e2e:flash": "npm run build && node e2e/flash.mjs"
  },
  "build": {
    "appId": "de.robin.wendehals",
    "productName": "Wendehals",
    "files": [
      "electron/**",
      "dist/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Game"
    },
    "publish": null
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.56.1"
  }
}
